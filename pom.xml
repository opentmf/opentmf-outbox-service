<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot via <parent>: the library compiles against the
       same Boot line its consumers run; consumers' own parents win at runtime. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath />
  </parent>

  <groupId>org.opentmf.util</groupId>
  <artifactId>opentmf-outbox-service</artifactId>
  <version>1.1.1-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>opentmf-outbox-service</name>
  <url>https://github.com/opentmf/opentmf-outbox-service</url>
  <description>Transactional outbox as a Spring Boot starter: library-owned
    Liquibase DDL, an at-least-once single-relay with SKIP LOCKED claims, a pluggable
    publisher SPI (Kafka default, HTTP with per-row client-profile selection), and the
    /ops maintenance TRIO — prune, unpark, and a TMF630-shaped pending list.
  </description>

  <organization>
    <name>PiA Group</name>
    <url>https://www.pia-group.net/</url>
  </organization>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
      <comments>A permissive open-source license</comments>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>cezmi-aslan</id>
      <name>Cezmi Aslan</name>
      <email>cezmi.aslan@pia-team.com</email>
    </developer>
    <developer>
      <id>gokhanus</id>
      <name>Gokhan Demir</name>
      <email>gokhan@opentmf.org</email>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/opentmf/opentmf-outbox-service</url>
    <connection>scm:git:git@github.com:opentmf/opentmf-outbox-service.git</connection>
    <developerConnection>scm:git:git@github.com:opentmf/opentmf-outbox-service.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Explicit-name rule (ArchUnit-enforced in consumers): keep -parameters off
         so a missing annotation name fails here too, not at a consumer. -->
    <maven.compiler.parameters>false</maven.compiler.parameters>

    <!-- Stable-only filter for versions:display-* goals. -->
    <maven.version.ignore>.*-M\d+,.*-RC\d+,.*-SNAPSHOT,(?i).*-(alpha|beta)\d*</maven.version.ignore>

    <!-- An opentmf library never imports the opentmf-versions BOM (the BOM
         aggregates the libraries — a library importing it would be a cycle in
         spirit and a lockstep coupling in practice). Direct property pin. -->
    <tmf630-toolkit.version>3.1.1</tmf630-toolkit.version>

    <!-- Non-BOM-managed pins live here so versions:display-property-updates sees them. -->
    <archunit.version>1.5.0</archunit.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>

    <!-- jakarta classifier needs the explicit version (shared with querydsl-apt). -->
    <querydsl.version>5.1.0</querydsl.version>

    <!-- Quality-gate branch statement: THIS REPO RUNS THE 1.19.6 HOLD WITH
         INCREMENTAL HISTORY — a deliberate branch, not a stale version: free
         withHistory moved behind the
         commercial arcmutate plugin from 1.20, where the bare flag FAILS the run.
         The junit5 plugin stays at 1.2.3 WITH it (1.2.1 crashes JDK 25 with
         "Coverage generation minion exited abnormally"). Quote both versions
         whenever the pin is. -->
    <pitest.version>1.19.6</pitest.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>

    <!-- Release machinery (donor: opentmf-db-lock-service). The Boot parent manages
         source/javadoc/deploy; it pins maven-release-plugin at 3.0.1, overridden here to
         3.3.1. gpg + central-publishing are not Boot-managed. -->
    <maven-release-plugin.version>3.3.1</maven-release-plugin.version>
    <sonar-maven-plugin.version>5.7.0.6970</sonar-maven-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
  </properties>

  <dependencies>
    <!-- ================================================================ -->
    <!-- Core: JPA persistence + transactions (the outbox IS a table)      -->
    <!-- ================================================================ -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- ================================================================ -->
    <!-- Publisher SPI implementations — both OPTIONAL: the consumer's     -->
    <!-- classpath decides which auto-configure (Kafka default; HTTP for   -->
    <!-- HTTP destinations with the per-row client-profile selector)       -->
    <!-- ================================================================ -->
    <!-- Boot 4 split: spring-kafka alone is NOT auto-configured - a consumer using
         Kafka destinations needs BOTH spring-kafka and spring-boot-kafka. -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-kafka</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- NO opentmf-http-clients dependency here, deliberately: the HTTP publisher
         works through Spring's RestClient + the OutboxClientProfileResolver SPI.
         A consumer wanting NAMED authenticated clients brings the
         opentmf-http-clients starter itself and implements the resolver - the
         library stays free of that starter's mandatory configuration surface. -->

    <!-- ================================================================ -->
    <!-- The /ops trio: REST + the TMF630 toolkit list (the list endpoint  -->
    <!-- carries the FULL toolkit surface —                                -->
    <!-- Page + Pageable + @QuerydslPredicate + @Tmf630Response)           -->
    <!-- ================================================================ -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.opentmf.query</groupId>
      <artifactId>tmf630-toolkit-all</artifactId>
      <version>${tmf630-toolkit.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.querydsl</groupId>
      <artifactId>querydsl-jpa</artifactId>
      <version>${querydsl.version}</version>
      <classifier>jakarta</classifier>
    </dependency>

    <!-- Observability: the gauges (pending / parked / relay-lag / relayed). -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>

    <!-- The library-provided seal rule (OutboxArchRules) — optional: only test
         classpaths ever see it. anything older
         (<=1.4.x ASM) cannot parse Java 25 bytecode (class file major 69) and the rule silently checks NOTHING — caught by OutboxArchRulesTests. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>${archunit.version}</version>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- ================================================================ -->
    <!-- Tests: H2-free by principle — the DDL is PostgreSQL, so the ITs   -->
    <!-- run the real engine via Testcontainers.                          -->
    <!-- ================================================================ -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Actuator in ITs so the gauges register against a REAL composite registry. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 split: MockMvc autoconfiguration lives in the webmvc test starter
         -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Testcontainers 2.x — Boot-managed versions: the
         jdbc:tc: postgres driver + the Kafka container. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.liquibase</groupId>
      <artifactId>liquibase-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 split: liquibase-core alone is NOT auto-configured — the Boot liquibase module carries the auto-config. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-liquibase</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Annotation processing: Lombok FIRST, then the
           Querydsl jakarta APT for the toolkit's Q-classes. An apt-maven-plugin would
           hijack processing and silently drop Lombok - hence processor paths. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <proc>full</proc>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>
            <path>
              <groupId>com.querydsl</groupId>
              <artifactId>querydsl-apt</artifactId>
              <classifier>jakarta</classifier>
              <version>${querydsl.version}</version>
            </path>
            <path>
              <groupId>jakarta.persistence</groupId>
              <artifactId>jakarta.persistence-api</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <!-- Coverage gate: 90% line / instruction / branch - a library holds the
           stricter bar of its consumers. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <configuration>
          <!-- Querydsl-generated metamodel: build artifact, not library code under test. -->
          <excludes>
            <exclude>**/QOutboxEvent*</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>prepare</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <!-- post-integration-test, not test: the agent appends failsafe (IT) coverage
                 to the same exec file, so reporting after integration-test folds the ITs in.
                 Not verify either: the sonar profile's delayed scan runs in verify and must
                 find the XML already written. check (default phase verify) then gates on the
                 merged data. -->
            <phase>post-integration-test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>90%</minimum>
                    </limit>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>90%</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>90%</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Release cut: mvn release:prepare release:perform. The release profile below
           (sources, javadoc, signing, Central publishing) is activated via
           releaseProfiles - never useReleaseProfile. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-release-plugin</artifactId>
        <version>${maven-release-plugin.version}</version>
        <configuration>
          <releaseProfiles>release</releaseProfiles>
          <goals>deploy</goals>
        </configuration>
      </plugin>
      <!-- *IT classes (Testcontainers round-trips) run under failsafe at verify. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-toolchain</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[17,18)</version>
                  <message>This library builds with JDK 17.x (its bytecode/API baseline). Use a 17 JDK.</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,3.10)</version>
                  <message>This library builds with Maven 3.9.x.</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Mutation testing (PIT rides the library from day one).
         Run: mvn -Pmutation test-compile org.pitest:pitest-maven:mutationCoverage
         Branch statement: the pinned 1.19.6 hold WITH incremental history (see the pin
         comment in <properties>). NO mutationThreshold - survivor review is the unit
         of work; the JACOCO 90/90/90 gate is the enforced floor. -->
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>${pitest.version}</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest-junit5.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>org.opentmf.outbox.*</param>
              </targetClasses>
              <targetTests>
                <param>org.opentmf.outbox.*</param>
              </targetTests>
              <excludedTestClasses>
                <param>org.opentmf.outbox.*IT</param>
              </excludedTestClasses>
              <outputFormats>
                <param>HTML</param>
              </outputFormats>
              <timestampedReports>false</timestampedReports>
              <!-- withHistory is WHY the 1.19.6 hold exists. KNOWN COST
                   (the un-retired <=1.19 gotcha): the history file is keyed on mutated-class hashes ONLY — strengthening a TEST does not invalidate an entry, so DELETE the history file before a survivor review or after material test changes. -->
              <withHistory>true</withHistory>
              <!-- NO mutationThreshold — survivor review is the unit of work. -->
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Local SonarQube analysis as part of the normal build: mvn -Psonar clean verify.
         sonar.host.url MUST be explicit (SonarScanner 5.x targets SonarQube Cloud when
         absent). Credentials via -Dsonar.token=... or the SONAR_TOKEN environment
         variable, never the pom. Coverage: the scanner auto-discovers
         target/site/jacoco/jacoco.xml; xmlReportPaths is intentionally not set. The
         scan binds to verify, after the jacoco report - see the report execution. -->
    <profile>
      <id>sonar</id>
      <properties>
        <sonar.host.url>http://localhost:9000</sonar.host.url>
        <sonar.projectKey>opentmf-outbox-service</sonar.projectKey>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.sonarsource.scanner.maven</groupId>
            <artifactId>sonar-maven-plugin</artifactId>
            <version>${sonar-maven-plugin.version}</version>
            <executions>
              <execution>
                <id>sonar-scan</id>
                <phase>verify</phase>
                <goals>
                  <goal>sonar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Release-only plugins live HERE, not in the default build: normal builds do
         not generate source/javadoc jars, sign, or publish. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <failOnWarnings>false</failOnWarnings>
                  <failOnError>false</failOnError>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-maven-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>publish-to-central</publishingServerId>
              <autoPublish>true</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
