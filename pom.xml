<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot via <parent> (combined-rules §1): the library compiles against the
       same Boot line its consumers run; consumers' own parents win at runtime. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>org.opentmf.util</groupId>
  <artifactId>opentmf-outbox-service</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>opentmf-outbox-service</name>
  <description>Transactional outbox as a Spring Boot starter (CR §23, extracted from
    dnms-email-adapter's sealed module per the 2026-08-26 ruling): library-owned
    Liquibase DDL, an at-least-once single-relay with SKIP LOCKED claims, a pluggable
    publisher SPI (Kafka default, HTTP with per-row client-profile selection), and the
    /ops maintenance TRIO — prune, unpark, and a TMF630-shaped pending list.</description>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- §5 explicit-name rule (ArchUnit-enforced in consumers): keep -parameters off
         so a missing annotation name fails here too, not at a consumer. -->
    <maven.compiler.parameters>false</maven.compiler.parameters>

    <!-- Stable-only filter for versions:display-* goals. -->
    <maven.version.ignore>.*-M\d+,.*-RC\d+,.*-SNAPSHOT,(?i).*-(alpha|beta)\d*</maven.version.ignore>

    <!-- opentmf BOM — the de-facto inventory of opentmf artifacts; never pin an
         opentmf artifact's version directly. 2.1.19 = Central's latest at extraction
         time (2026-08-26, per Cezmi: always the latest release). -->
    <opentmf-versions.version>2.1.19</opentmf-versions.version>

    <!-- jakarta classifier needs the explicit version (shared with querydsl-apt). -->
    <querydsl.version>5.1.0</querydsl.version>

    <!-- Quality-gate branch statement (combined-rules pitest rule): THIS REPO RUNS
         THE RULED 1.19.6 HOLD WITH INCREMENTAL HISTORY (Cezmi 2026-08-26) — the
         estate's branch, not a stale version: free withHistory moved behind the
         commercial arcmutate plugin from 1.20, where the bare flag FAILS the run.
         The junit5 plugin stays at 1.2.3 WITH it (1.2.1 crashes JDK 25 with
         "Coverage generation minion exited abnormally"). Quote both versions
         whenever the pin is. -->
    <pitest.version>1.19.6</pitest.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.opentmf</groupId>
        <artifactId>opentmf-versions</artifactId>
        <version>${opentmf-versions.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- ================================================================ -->
    <!-- Core: JPA persistence + transactions (the outbox IS a table)      -->
    <!-- ================================================================ -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- ================================================================ -->
    <!-- Publisher SPI implementations — both OPTIONAL: the consumer's     -->
    <!-- classpath decides which auto-configure (Kafka default; HTTP for   -->
    <!-- adapter-call destinations with the per-row client-profile         -->
    <!-- selector, per the 2026-08-26 hub ruling)                          -->
    <!-- ================================================================ -->
    <!-- Boot 4 split: spring-kafka alone is NOT auto-configured - a consumer using
         Kafka destinations needs BOTH spring-kafka and spring-boot-kafka (dnms
         services get both via their platform starters). -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-kafka</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- NO opentmf-http-clients dependency here, deliberately: the HTTP publisher
         works through Spring's RestClient + the OutboxClientProfileResolver SPI.
         A consumer wanting NAMED authenticated clients (the hub ruling) brings the
         opentmf-http-clients starter itself and implements the resolver - the
         library stays free of that starter's mandatory configuration surface. -->

    <!-- ================================================================ -->
    <!-- The /ops trio: REST + the TMF630 toolkit list (ruling 7.3         -->
    <!-- amendment: the list endpoint carries the FULL toolkit surface —   -->
    <!-- Page + Pageable + @QuerydslPredicate + @Tmf630Response)           -->
    <!-- ================================================================ -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.opentmf.query</groupId>
      <artifactId>tmf630-toolkit-all</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.querydsl</groupId>
      <artifactId>querydsl-jpa</artifactId>
      <version>${querydsl.version}</version>
      <classifier>jakarta</classifier>
    </dependency>

    <!-- Observability: the §23 gauges (pending / parked / relay-lag / relayed). -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>

    <!-- The library-provided seal rule (OutboxArchRules) — optional: only test
         classpaths ever see it. 1.5.0 = the dnms estate's version; anything older
         (<=1.4.x ASM) cannot parse Java 25 bytecode (class file major 69) and the
         rule silently checks NOTHING — caught by OutboxArchRulesTests. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>1.5.0</version>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- ================================================================ -->
    <!-- Tests: H2-free by principle — the DDL is PostgreSQL, so the ITs   -->
    <!-- run the real engine via Testcontainers (estate §17 posture).      -->
    <!-- ================================================================ -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Actuator in ITs so the gauges register against a REAL composite registry. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 split: MockMvc autoconfiguration lives in the webmvc test starter
         (the 2026-08-21 adapter finding). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Testcontainers 2.x — Boot-managed versions (the adapter precedent): the
         jdbc:tc: postgres driver + the Kafka container. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.liquibase</groupId>
      <artifactId>liquibase-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 split: liquibase-core alone is NOT auto-configured (the adapter's
         documented finding) — the Boot liquibase module carries the auto-config. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-liquibase</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Annotation processing (the dnms-catalog precedent): Lombok FIRST, then the
           Querydsl jakarta APT for the toolkit's Q-classes. An apt-maven-plugin would
           hijack processing and silently drop Lombok - hence processor paths. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <proc>full</proc>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>
            <path>
              <groupId>com.querydsl</groupId>
              <artifactId>querydsl-apt</artifactId>
              <classifier>jakarta</classifier>
              <version>${querydsl.version}</version>
            </path>
            <path>
              <groupId>jakarta.persistence</groupId>
              <artifactId>jakarta.persistence-api</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <!-- Coverage gate: 90% line / instruction / branch - the HIGHER of the two
           estates (dnms services run 90/90/90, opentmf-db-lock-service runs 80/60;
           Cezmi's 2026-08-26 rule: the library holds the stricter bar). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <configuration>
          <!-- Querydsl-generated metamodel: build artifact, not library code under test. -->
          <excludes>
            <exclude>**/QOutboxEvent*</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>prepare</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <!-- verify, not test: the agent appends failsafe (IT) coverage to the same exec
                 file, so reporting after integration-test folds the ITs in. check (below,
                 default phase verify, declared after report) then gates on the merged data. -->
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>90%</minimum></limit>
                    <limit><counter>INSTRUCTION</counter><value>COVEREDRATIO</value><minimum>90%</minimum></limit>
                    <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>90%</minimum></limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- *IT classes (Testcontainers round-trips) run under failsafe at verify. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Mutation testing (Cezmi 2026-08-26: PIT rides the library from day one).
         Run: mvn -Pmutation test-compile org.pitest:pitest-maven:mutationCoverage
         Branch statement: the RULED 1.19.6 hold WITH incremental history (see the pin
         comment in <properties>). NO mutationThreshold - survivor review is the unit
         of work (the dnms posture); the JACOCO 90/90/90 gate is the enforced floor. -->
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>${pitest.version}</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest-junit5.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses><param>org.opentmf.outbox.*</param></targetClasses>
              <targetTests><param>org.opentmf.outbox.*</param></targetTests>
              <excludedTestClasses><param>org.opentmf.outbox.*IT</param></excludedTestClasses>
              <outputFormats><param>HTML</param></outputFormats>
              <timestampedReports>false</timestampedReports>
              <!-- withHistory is WHY the 1.19.6 hold exists (CR §17). KNOWN COST
                   (the un-retired <=1.19 gotcha): the history file is keyed on
                   mutated-class hashes ONLY — strengthening a TEST does not
                   invalidate an entry, so DELETE the history file before a survivor
                   review or after material test changes. -->
              <withHistory>true</withHistory>
              <!-- NO mutationThreshold — survivor review is the unit of work (§17). -->
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
