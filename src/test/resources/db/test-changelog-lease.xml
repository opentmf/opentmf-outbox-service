<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <include file="db/changelog/opentmf-outbox.sql"/>
  <!-- Consumer tables a publisher's BOOKING HOOK writes (flow's ACRM id, 681's suspension). -->
  <changeSet id="lease-consumer-tables" author="outbox-lease-it">
    <sql>
      create table side_effect (outbox_id bigint primary key, acrm_id varchar(64) not null);
      create table suspended (outbox_id bigint primary key, reason varchar(200) not null);
    </sql>
  </changeSet>
</databaseChangeLog>
